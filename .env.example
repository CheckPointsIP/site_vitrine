# Configuration Backend Analytics - Plan B CRM
# Copiez ce fichier vers .env et configurez vos valeurs

# Port du serveur Node.js
PORT=3000

# Mode debug (true/false)
DEBUG_MODE=true

# Dossier de stockage des données
DATA_DIR=./analytics-data

# Identifiants Admin (CHANGEZ-LES EN PRODUCTION !)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API Configuration
API_ENDPOINT=/api/analytics

# Session timeout (en millisecondes)
# 30 minutes = 1800000
SESSION_TIMEOUT=1800000

# LocalStorage limit (nombre d'entrées max par type)
LOCALSTORAGE_LIMIT=1000

# Auto-send interval (en millisecondes)
# 30 secondes = 30000
AUTO_SEND_INTERVAL=30000

# Email notifications (optionnel - pour future implémentation)
# EMAIL_SERVICE=gmail
# EMAIL_USER=votre-email@gmail.com
# EMAIL_PASS=votre-mot-de-passe
# ALERT_EMAIL=admin@votredomaine.fr

# Database (optionnel - pour future migration vers DB)
# DB_TYPE=mongodb
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=planb_analytics
# DB_USER=
# DB_PASS=

# CORS (pour production)
# ALLOWED_ORIGINS=https://votredomaine.fr,https://www.votredomaine.fr

# Rate Limiting (pour production)
# RATE_LIMIT_WINDOW=900000  # 15 minutes
# RATE_LIMIT_MAX=100        # 100 requêtes max

# HTTPS (pour production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
