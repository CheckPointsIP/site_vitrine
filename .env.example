# Configuration Backend Analytics - Plan B CRM
# Template de configuration (SANS SECRETS RÉELS)
# Copier ce fichier vers .env et remplacer les valeurs

# ========================================
# SERVEUR
# ========================================
PORT=3000
NODE_ENV=development
DEBUG_MODE=true

# ========================================
# SÉCURITÉ JWT
# ========================================
# ⚠️ GÉNÉRER UN NOUVEAU SECRET AVEC: npm run generate-secret
JWT_SECRET=CHANGEZ_MOI_UTILISEZ_npm_run_generate-secret

# Durée de validité des tokens (en secondes)
JWT_EXPIRATION=28800              # 8 heures
JWT_REFRESH_EXPIRATION=604800     # 7 jours

# ========================================
# AUTHENTIFICATION ADMIN
# ========================================
ADMIN_USERNAME=admin
# ⚠️ GÉNÉRER UN HASH AVEC: npm run hash-password VotreMotDePasse
ADMIN_PASSWORD_HASH=CHANGEZ_MOI_UTILISEZ_npm_run_hash-password

# ========================================
# STOCKAGE DONNÉES
# ========================================
DATA_DIR=./analytics-data

# ========================================
# LOGS
# ========================================
LOG_LEVEL=info
LOG_DIR=./logs

# ========================================
# RATE LIMITING (Protection DDoS)
# ========================================
RATE_LIMIT_WINDOW=900000          # 15 minutes
RATE_LIMIT_MAX=100                # 100 requêtes max
AUTH_RATE_LIMIT_WINDOW=900000
AUTH_RATE_LIMIT_MAX=5

# ========================================
# CORS (Origines autorisées)
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========================================
# SESSION
# ========================================
SESSION_TIMEOUT=1800000           # 30 minutes

# ========================================
# ANALYTICS TRACKER
# ========================================
API_ENDPOINT=/api/analytics
AUTO_SEND_INTERVAL=30000
LOCALSTORAGE_LIMIT=1000
